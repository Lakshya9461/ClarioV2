# Clario Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS whitelist in production)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or local URI)
MONGODB_URI=

# Redis Cache & Rate Limiting (Upstash or local Redis)
REDIS_URL=

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d

# Daily Rate Limit (default: 10 queries/user/day)
DAILY_QUESTION_LIMIT=10

# Active LLM API Configuration (Qwen 3.8 Flash via Strata Gateway)
LLM_API_URL=https://strata.lakshya9461.in/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=qwen3.8-flash-next-gyro-gyro-m
